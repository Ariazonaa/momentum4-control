<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Momentum4.App.InspectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Momentum4.App.Localization"
    xmlns:vm="using:Momentum4.App.ViewModels"
    Title="Protokoll-Inspektor">

    <Grid Padding="16" Background="{StaticResource AmoledBackgroundBrush}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Loc Key=InspectorTitle}" />
            <ToggleButton Content="{loc:Loc Key=Pause}" IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}" />
            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{loc:Loc Key=Clear}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{loc:Loc Key=InspectorHint}" />

        <ListView
            Grid.Row="2"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            ItemsSource="{x:Bind ViewModel.Entries}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:InspectorEntry">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Time}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Direction}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Id}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" IsTextSelectionEnabled="True" Text="{x:Bind Payload}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Decoded}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="6" HorizontalAlignment="Right" Text="{x:Bind Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
